# Repo HuggingFace du modele (variante distillee par defaut, plus rapide sur CPU)
MODEL_ID=bofenghuang/whisper-large-v3-french-distil-dec4

# A definir uniquement si vous voulez pointer sur un checkpoint deja telecharge localement
# (chemin absolu vers le dossier ctranslate2/), sinon laisser vide.
MODEL_LOCAL_PATH=

PORT=8000

# Origine autorisee pour les requetes CORS / WebSocket (le serveur vite de rebond)
CORS_ORIGIN=http://localhost:5173
